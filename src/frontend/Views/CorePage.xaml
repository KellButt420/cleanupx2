<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Cleanup.Views.CorePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Cleanup.Controls"
    xmlns:views="using:Cleanup.Views"
    xmlns:vm="using:Cleanup.ViewModels">

    <Page.Resources>
        <Style x:Key="CoreSectionStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Padding="24,16,24,24" Spacing="16">
            <Grid ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Core" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="SummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshClick" />
            </Grid>

            <!-- Used and free space across every ready drive that counts toward the totals. -->
            <Grid ColumnSpacing="28" AutomationProperties.Name="Combined storage">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="200" Height="200">
                    <controls:SpaceRing x:Name="Ring" RingThickness="18" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="FreeText" Text="—" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="free" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="All drives combined" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="UsedText" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                            <TextBlock x:Name="FreeLegendText" />
                        </StackPanel>
                        <TextBlock x:Name="TotalText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Counts ready local, removable and connected network drives. Optical drives are not included." />
                </StackPanel>
            </Grid>

            <TextBlock Text="Drives" Style="{StaticResource CoreSectionStyle}" />
            <ItemsRepeater x:Name="DriveList" AutomationProperties.Name="Connected drives" ElementPrepared="OnDriveElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinRowSpacing="16" MinColumnSpacing="24" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveItemViewModel">
                        <Grid ColumnSpacing="14" Padding="0,4" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneTime}" FontSize="26" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="UsageBar" Value="{x:Bind UsedPercent, Mode=OneTime}" Margin="0,6,0,2" Visibility="{x:Bind views:Ui.Visible(ShowsBar), Mode=OneTime}" />
                                <TextBlock Text="{x:Bind Capacity, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
