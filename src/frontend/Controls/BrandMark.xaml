<UserControl
    x:Class="Cleanup.Controls.BrandMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Preserve the logo's original proportions while coloring its four tiles live. -->
    <Viewbox>
        <Grid Width="638" Height="638">
            <Border x:Name="TopLeft" Width="286.375" Height="286.375" CornerRadius="68.875" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Border x:Name="TopRight" Width="286.375" Height="286.375" CornerRadius="68.875" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Border x:Name="BottomLeft" Width="286.375" Height="286.375" CornerRadius="68.875" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Border x:Name="BottomRight" Width="286.375" Height="286.375" CornerRadius="68.875" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </Viewbox>
</UserControl>
