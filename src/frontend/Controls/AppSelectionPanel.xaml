<UserControl x:Class="Cleanup.Controls.AppSelectionPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Cleanup.ViewModels"
 xmlns:views="using:Cleanup.Views">
 <UserControl.Resources>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
   <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="IsTextSelectionEnabled" Value="True"/>
  </Style>
 </UserControl.Resources>

 <!-- Text first, then (for several apps) their icons, and the Remove action
      always last, directly above the Settings entry. -->
 <Grid x:Name="PanelRoot" Margin="8,12,8,4" Visibility="{x:Bind views:Ui.Visible(ViewModel.HasSelection), Mode=OneWay}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- Header: name or count, with clear selection. -->
  <Grid ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="SingleHeader" ColumnSpacing="10" Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowDetails), Mode=OneWay}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Width="32" Height="32" VerticalAlignment="Top">
     <Border Background="{x:Bind ViewModel.Selected.AvatarBrush, Mode=OneWay}" CornerRadius="7" Visibility="{x:Bind views:Ui.Collapsed(ViewModel.Selected.HasIcon), Mode=OneWay}">
      <TextBlock Text="{x:Bind ViewModel.Selected.Initial, Mode=OneWay}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <Image Source="{x:Bind ViewModel.Selected.Icon, Mode=OneWay}"/>
    </Grid>
    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
     <TextBlock Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"/>
     <TextBlock Text="{x:Bind ViewModel.Selected.PublisherText, Mode=OneWay}" Style="{StaticResource Label}" TextWrapping="Wrap" MaxLines="2"/>
    </StackPanel>
   </Grid>
   <StackPanel x:Name="MultipleHeader" Spacing="6" Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowMultiple), Mode=OneWay}">
    <TextBlock x:Name="MultipleTitleText" Text="{x:Bind ViewModel.MultipleTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock Text="{x:Bind ViewModel.MultipleSummary, Mode=OneWay}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
   </StackPanel>
   <Button Grid.Column="1" VerticalAlignment="Top" Padding="6" Background="Transparent" BorderThickness="0" Click="OnClearClick" AutomationProperties.Name="Clear application selection" ToolTipService.ToolTip="Clear selection">
    <FontIcon Glyph="&#xE711;" FontSize="10"/>
   </Button>
  </Grid>

  <!-- Single app: details (scroll if the window is short). -->
  <ScrollViewer x:Name="SingleDetails" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowDetails), Mode=OneWay}">
   <StackPanel Spacing="12" Padding="0,0,4,0">
    <StackPanel Spacing="4" Visibility="{x:Bind views:Ui.Collapsed(ViewModel.Selected.CanRemove), Mode=OneWay}">
     <TextBlock Text="{x:Bind ViewModel.Selected.RemoveBlockedReason, Mode=OneWay}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
     <HyperlinkButton Content="Open Windows Settings" Padding="0" Click="OnWindowsSettingsClick" FontSize="12"/>
    </StackPanel>
    <Grid ColumnSpacing="12" RowSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="2"><TextBlock Text="Version" Style="{StaticResource Label}"/><TextBlock Text="{x:Bind ViewModel.Selected.VersionText, Mode=OneWay}" Style="{StaticResource Value}"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Size" Style="{StaticResource Label}"/><TextBlock Text="{x:Bind ViewModel.Selected.SizeDetail, Mode=OneWay}" Style="{StaticResource Value}"/></StackPanel>
     <StackPanel Grid.Row="1" Spacing="2"><TextBlock Text="Installed" Style="{StaticResource Label}"/><TextBlock Text="{x:Bind ViewModel.Selected.DateDetail, Mode=OneWay}" Style="{StaticResource Value}"/></StackPanel>
     <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2"><TextBlock Text="Type" Style="{StaticResource Label}"/><TextBlock Text="{x:Bind ViewModel.Selected.TypeText, Mode=OneWay}" Style="{StaticResource Value}"/></StackPanel>
     <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2"><TextBlock Text="Installed for" Style="{StaticResource Label}"/><TextBlock Text="{x:Bind ViewModel.Selected.ScopeText, Mode=OneWay}" Style="{StaticResource Value}"/></StackPanel>
     <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
      <TextBlock Text="Location" Style="{StaticResource Label}"/>
      <HyperlinkButton x:Name="InstallLocationLink" Padding="0" MinHeight="0" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnLocationClick"
                       Visibility="{x:Bind views:Ui.Visible(ViewModel.Selected.HasLocation), Mode=OneWay}" AutomationProperties.Name="Open install location" ToolTipService.ToolTip="{x:Bind ViewModel.Selected.LocationText, Mode=OneWay}">
       <TextBlock Text="{x:Bind ViewModel.Selected.LocationText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
      </HyperlinkButton>
      <TextBlock Text="{x:Bind ViewModel.Selected.LocationText, Mode=OneWay}" Style="{StaticResource Value}" Visibility="{x:Bind views:Ui.Collapsed(ViewModel.Selected.HasLocation), Mode=OneWay}"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </ScrollViewer>

  <!-- Several apps: their icons, below the text. -->
  <Grid x:Name="IconStrip" Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="6" Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowMultiple), Mode=OneWay}"
        AutomationProperties.Name="Selected application icons" AutomationProperties.AccessibilityView="Content">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ItemsRepeater x:Name="SelectedIcons" ElementPrepared="OnIconPrepared" ItemsSource="{x:Bind ViewModel.SelectionIcons, Mode=OneWay}">
    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="4"/></ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate>
     <DataTemplate x:DataType="vm:AppItemViewModel">
      <Grid Width="20" Height="20" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.AccessibilityView="Content">
       <Border Background="{x:Bind AvatarBrush}" CornerRadius="5" Visibility="{x:Bind views:Ui.Collapsed(HasIcon), Mode=OneWay}"><TextBlock Text="{x:Bind Initial}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <Image Source="{x:Bind Icon, Mode=OneWay}"/>
      </Grid>
     </DataTemplate>
    </ItemsRepeater.ItemTemplate>
   </ItemsRepeater>
   <TextBlock x:Name="SelectionOverflow" Grid.Column="1" Text="{x:Bind ViewModel.AdditionalSelectionText, Mode=OneWay}" Visibility="{x:Bind views:Ui.Visible(ViewModel.HasAdditionalSelection), Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.AdditionalSelectionDescription, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.AdditionalSelectionDescription, Mode=OneWay}"/>
  </Grid>

  <!-- Actions, always at the bottom. -->
  <Grid x:Name="SingleActions" Grid.Row="3" Margin="0,12,0,0" ColumnSpacing="6" Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowDetails), Mode=OneWay}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Click="OnOpenClick" HorizontalAlignment="Stretch" AutomationProperties.Name="Open" ToolTipService.ToolTip="Open this app or game"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock Text="Open"/></StackPanel></Button>
   <Button Grid.Column="1" Content="Remove" Click="OnRemoveClick" IsEnabled="{x:Bind ViewModel.CanRemoveSelected, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
  </Grid>
  <Button x:Name="MultipleRemove" Grid.Row="3" Margin="0,12,0,0" Content="{x:Bind ViewModel.RemoveMultipleText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanRemoveMultiple, Mode=OneWay}" Click="OnRemoveClick" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
          Visibility="{x:Bind views:Ui.Visible(ViewModel.ShowMultiple), Mode=OneWay}"/>
 </Grid>
</UserControl>
