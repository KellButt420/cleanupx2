# All VITE_ values are public. Never put secrets here.
# Leave unset while cleanup is a development build.
VITE_REPOSITORY_URL=
VITE_DOWNLOAD_URL=
# Configure only after the package is available in the community source.
VITE_WINGET_ID=
# Optional overrides for the public defaults in ../release.json.
VITE_DISCORD_URL=
VITE_SITE_URL=
# Configure only after a production-signed release and update feed are published.
VITE_APP_INSTALLER_URL=
VITE_PORTABLE_URL=
