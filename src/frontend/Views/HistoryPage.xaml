<Page x:Class="Cleanup.Views.HistoryPage" NavigationCacheMode="Required"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Cleanup.ViewModels" xmlns:interop="using:Cleanup.Interop">
 <Page.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="HistoryPaneBrush" Color="#252529"/></ResourceDictionary>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="HistoryPaneBrush" Color="#F9F9FB"/></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="HistoryPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/></ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary>
 </Page.Resources>
 <Grid Padding="24,16,24,24" RowSpacing="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Spacing="4"><TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock x:Name="HistoryCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button x:Name="RefreshButton" Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnRefreshClick"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="Search history" AutomationProperties.Name="Search history" TextChanged="OnSearchChanged"/>
   <ComboBox x:Name="TypeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="History type" SelectionChanged="OnFilterChanged"><x:String>All changes</x:String><x:String>File moves</x:String><x:String>App removals</x:String><x:String>Leftover cleanup</x:String></ComboBox>
   <ComboBox x:Name="StateBox" Grid.Column="2" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="History status" SelectionChanged="OnFilterChanged"><x:String>Any status</x:String><x:String>Needs review</x:String><x:String>Can undo</x:String><x:String>Restored</x:String></ComboBox>
  </Grid>
  <InfoBar x:Name="Status" Grid.Row="2" IsOpen="False"/>
  <SplitView x:Name="DetailsView" Grid.Row="3" DisplayMode="Overlay" PanePlacement="Right" OpenPaneLength="390" IsPaneOpen="False" PaneBackground="{ThemeResource HistoryPaneBrush}">
   <SplitView.Pane>
    <Grid Padding="20" RowSpacing="14" Background="{ThemeResource HistoryPaneBrush}" CornerRadius="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Change details" Style="{StaticResource SubtitleTextBlockStyle}"/>
      <Button Grid.Column="1" AutomationProperties.Name="Close history details" ToolTipService.ToolTip="Close details" Click="OnCloseDetailsClick" Background="Transparent" BorderThickness="0" Padding="8"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
     </Grid>
     <ListView x:Name="DetailItems" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" AutomationProperties.Name="Recorded items">
      <ListView.Header>
       <StackPanel Spacing="6" Margin="0,0,0,12">
        <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="DetailDate" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="DetailSummary" TextWrapping="Wrap"/>
        <TextBlock x:Name="GuidanceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       </StackPanel>
      </ListView.Header>
      <ListView.ItemTemplate><DataTemplate x:DataType="interop:HistoryItem"><StackPanel Padding="0,10" Spacing="5">
       <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label, Mode=OneTime}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Outcome, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/></Grid>
       <TextBlock Text="{Binding Detail, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></DataTemplate></ListView.ItemTemplate>
      <ListView.Footer>
       <Expander x:Name="AuditExpander" Header="Technical details" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><TextBlock x:Name="AuditText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></Expander>
      </ListView.Footer>
     </ListView>
     <Button x:Name="UndoButton" Grid.Row="2" Content="Undo file moves" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnUndoClick"/>
    </Grid>
   </SplitView.Pane>
   <Grid>
    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
     <ListView x:Name="HistoryList" SelectionMode="Single" SelectionChanged="OnSelectionChanged" IsItemClickEnabled="True" ItemClick="OnItemClick" AutomationProperties.Name="Operation history" Padding="4">
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:HistoryItemViewModel">
       <Grid Padding="8,12" ColumnSpacing="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{Binding Glyph, Mode=OneTime}" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary, Mode=OneTime}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
        <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right"><TextBlock Text="{Binding ShortDate, Mode=OneTime}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="{Binding Status, Mode=OneTime}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
       </Grid>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Border>
    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
     <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="EmptyTitle" Text="Your changes will appear here" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock x:Name="EmptyDescription" Text="Remove an app or organize a folder to get started." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <ProgressRing x:Name="HistoryLoading" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid>
  </SplitView>
 </Grid>
</Page>
